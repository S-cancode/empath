DATABASE_URL="postgresql://empath:empath_dev@localhost:5432/empath"
REDIS_URL="redis://:empath_dev@localhost:6379"
JWT_SECRET="change-me-jwt-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
PORT=3000
NODE_ENV=development

# AI provider. Defaults to OpenAI: set OPENAI_API_KEY to an OpenAI key and the
# default model (gpt-4o-mini) is used against api.openai.com.
# OPENAI_API_KEY="sk-..."
#
# To route through OpenRouter instead: put an OpenRouter key in OPENAI_API_KEY
# and set OPENROUTER_MODEL to a namespaced id (contains a slash) —
# OPENAI_BASE_URL then defaults to https://openrouter.ai/api/v1 automatically.
# Note: embeddings (text-embedding-3-large) always require OpenAI; OpenRouter
# does not serve the embeddings endpoint.
# OPENROUTER_MODEL="google/gemini-2.0-flash-001"
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"
