DATABASE_URL="postgresql://empath:empath_dev@localhost:5432/empath"
REDIS_URL="redis://:empath_dev@localhost:6379"
JWT_SECRET="change-me-jwt-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
PORT=3000
NODE_ENV=development

# AI provider. OpenAI is the ONLY approved processor (signed DPA required).
# Set OPENAI_API_KEY to an OpenAI key; the default model (gpt-4o-mini) is used
# against api.openai.com. The boot-time AI guard refuses to start if
# OPENROUTER_MODEL is namespaced (contains a slash) or OPENAI_BASE_URL points
# anywhere other than https://api.openai.com/v1 — this blocks silently
# rerouting user content to an un-DPA'd processor. Do not "enable OpenRouter"
# here without first adding a signed DPA + transfer-risk assessment.
# OPENAI_API_KEY="sk-..."

# App Review deterministic demo path (OFF by default). When REVIEW_MODE=true, a
# signed-in reviewer redeems REVIEW_ACCESS_CODE (below) to get an isolated
# scripted demo conversation. REVIEW_APPLE_SUBS is an optional fallback
# allowlist of Apple `sub` values (rarely needed now that redemption exists).
REVIEW_MODE=false
REVIEW_APPLE_SUBS=
# Server-only secret the reviewer enters in-app (supply it in App Review notes).
# Min 16 chars. Never put this in the client / EXPO_PUBLIC_* / eas.json.
REVIEW_ACCESS_CODE=

# Sign in with Apple server-to-server credentials (for authorization-code
# exchange + token revocation on account deletion; Apple TN3194). All optional:
# without them, sign-in still works but Apple token revocation is unavailable
# and account deletion shows manual-revocation guidance instead.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PKCS#8 PEM of the .p8 key; literal \n escapes are fine (normalised at use).
APPLE_PRIVATE_KEY=
# Defaults to APPLE_BUNDLE_ID (com.shivandongha.empath) if unset.
APPLE_CLIENT_ID=
