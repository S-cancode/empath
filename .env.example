DATABASE_URL="postgresql://empath:empath_dev@localhost:5432/empath"
REDIS_URL="redis://:empath_dev@localhost:6379"
JWT_SECRET="change-me-jwt-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
PORT=3000
NODE_ENV=development

# AI (OpenRouter).
# Put the OpenRouter key in OPENAI_API_KEY — the service uses the OpenAI SDK
# with a custom base URL. If OPENROUTER_MODEL is a namespaced id (contains a
# slash), OPENAI_BASE_URL defaults to https://openrouter.ai/api/v1 so you
# don't have to set it explicitly.
# OPENAI_API_KEY="sk-or-v1-..."
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"
# OPENROUTER_MODEL="google/gemini-2.0-flash-001"
